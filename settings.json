{
  // Configurações de Font
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.8,
  "editor.fontWeight": "bold",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  // Configurações Extras
  "files.autoSave": "afterDelay",
  "editor.mouseWheelZoom": false,
  "editor.wordWrap": "on",
  "window.menuBarVisibility": "toggle",
  "workbench.sideBar.location": "right",
  "workbench.notifications.position": "bottom-left",
  "workbench.activityBar.location": "top",
  "prettier.experimentalTernaries": true,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.cursorBlinking": "phase",
  "window.commandCenter": false,
  "terminal.integrated.fontSize": 14,
  "prettier.singleQuote": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "vscode-pets.theme": "winter",
  "workbench.settings.applyToAllProfiles": ["vscode-pets.theme"],
  "vscode-pets.throwBallWithMouse": true,
  "vscode-pets.petSize": "nano",
  // Configurações Theme
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.colorTheme": "Bearded Theme Arc EolStorm",
  "vscode_vibrancy.preferredDarkTheme": "Bearded Theme Arc EolStorm",
  "vscode_vibrancy.preferredLightTheme": "Bearded Theme Arc EolStorm",
  "vscode_vibrancy.theme": "Bearded Theme Arc EolStorm",
  "settingsSync.ignoredSettings": [],
  "terminal.integrated.gpuAcceleration": "off",
  "window.systemColorTheme": "dark",
  "window.autoDetectColorScheme": false,
  "window.controlsStyle": "custom",
  "vscode_vibrancy.type": "mica",
  "vscode_vibrancy.opacity": 0.4,
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.colorCustomizations": {
    "terminal.background": "#00000000",
    "editorPane.background": "#1e1e1e00",
    "editorGroupHeader.tabsBackground": "#1e1e1e00",
    "editorGroupHeader.noTabsBackground": "#1e1e1e00",
    "breadcrumb.background": "#1e1e1e00",
    "editorGutter.background": "#1e1e1e00",
    "panel.background": "#1e1e1e00",
    "tab.activeBackground": "#1e1e1e00",
    "tab.unfocusedActiveBackground": "#1e1e1e00",
    "sideBar.background": "#1e1e1e66",
    "sideBarTitle.background": "#1e1e1e66",
    "activityBar.background": "#1e1e1e66",
    "editor.background": "#1e1e1e66",
    "tab.inactiveBackground": "#1e1e1e66",
    "tab.unfocusedInactiveBackground": "#1e1e1e66",
    "editorStickyScroll.background": "#1e1e1ebf",
    "editorStickyScrollGutter.background": "#1e1e1ebf",
    "sideBarStickyScroll.background": "#1e1e1ebf",
    "panelStickyScroll.background": "#1e1e1ebf",
    "terminalStickyScroll.background": "#1e1e1ebf",
    "minimap.background": "#1e1e1ebf",
    "inlineChat.background": "#1e1e1ee6",
    "editorWidget.background": "#1e1e1ee6",
    "editorHoverWidget.background": "#1e1e1ee6",
    "editorSuggestWidget.background": "#1e1e1ee6",
    "notifications.background": "#1e1e1ee6",
    "notificationCenterHeader.background": "#1e1e1ee6",
    "menu.background": "#1e1e1ee6",
    "quickInput.background": "#1e1e1ee6",
    "editor.lineHighlightBorder": "#00000000",
  },
  // Extras
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "workbench.editor.empty.hint": "hidden",
  "emmet.preferences": {},
  "python.analysis.completeFunctionParens": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.saveFileBeforeRun": true,
  "editor.fontVariations": false,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },
  "emmet.triggerExpansionOnTab": true,
  "github.copilot.enable": {
    "plaintext": true,
    "markdown": true,
    "scminput": true,
  },
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "inline",
  },
  "git.autofetch": true,
  "git.confirmSync": false,
}
